# Database Connection (SQLite local file or PostgreSQL connection string)
DATABASE_URL="file:./dev.db"

# JWT Secret for Session Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# OpenAI API Key for AI Financial Discrepancy Explainer (Optional: App falls back to local heuristic explainer if omitted)
OPENAI_API_KEY="sk-proj-..."

# Node Environment
NODE_ENV="development"
